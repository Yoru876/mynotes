<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_custom_back"
            android:scaleType="centerInside" />



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Configuración"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/silkscreen_regular"
            android:textColor="?attr/colorOnSurface"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:alpha="0.2"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apariencia"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:fontFamily="@font/silkscreen_regular"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_show_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mostrar imágenes en la lista"
                android:textSize="16sp"
                android:fontFamily="@font/silkscreen_regular"
                android:minHeight="48dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desactívalo para una vista más compacta de solo texto."
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/silkscreen_regular"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutline"
                android:alpha="0.2"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamaño de las Notas"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:fontFamily="@font/silkscreen_regular"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/radio_group_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_size_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Normal (2 columnas)"
                    android:paddingStart="8dp"
                    android:fontFamily="@font/silkscreen_regular"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rb_size_large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grande (1 columna)"
                    android:fontFamily="@font/silkscreen_regular"
                    android:paddingStart="8dp"/>
            </RadioGroup>

        </LinearLayout>
    </ScrollView>
</LinearLayout>